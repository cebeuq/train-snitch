{
  "_about": "Any OpenAI-compatible gateway or proxy (LiteLLM, Portkey, a company gateway); extra headers come from env.",
  "extends": "../generic/local-run.json",
  "name": "judge example: openai-compatible-gateway",
  "judge": {
    "enabled": true,
    "model": "gateway/small-model",
    "api": "openai-completions",
    "base_url": "https://llm-gateway.example.com/v1",
    "api_key_env": "GATEWAY_API_KEY",
    "headers": {
      "x-team-id": "$GATEWAY_TEAM_ID"
    },
    "model_info": {
      "context_window": 128000,
      "max_tokens": 1024,
      "cost": {
        "input": 0.15,
        "output": 0.6
      }
    },
    "cost_cap_usd": 2
  }
}
